# ============================================================================
# HUB75 RGB LED 点阵（Waveshare RGB-Matrix-P2.5-64x64, 64x64, 1R1G1B, 1/32 扫）
# 全部走板上 J1 点阵扩展座的脚位；这 14 个脚在本工程里此前完全空闲。
# 已避开原厂标为 I2S 输入的 L14(dataout1)/F13(en3)/J13(en7)，
# 以免将来接回板载 I2S 时冲突。
# ============================================================================
set_pin_assignment	{ HUB_R1 }		{ LOCATION = K12; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }	# J1 dataout[0]
set_pin_assignment	{ HUB_G1 }		{ LOCATION = M14; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }	# J1 dataout[2]
set_pin_assignment	{ HUB_B1 }		{ LOCATION = P11; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }	# J1 dataout[3]
set_pin_assignment	{ HUB_R2 }		{ LOCATION = L10; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }	# J1 dataout[4]
set_pin_assignment	{ HUB_G2 }		{ LOCATION = M10; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }	# J1 dataout[5]
set_pin_assignment	{ HUB_B2 }		{ LOCATION = D16; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }	# J1 dataout[6]
set_pin_assignment	{ HUB_ADDR[0] }	{ LOCATION = D14; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }	# J1 en[0]  -> A
set_pin_assignment	{ HUB_ADDR[1] }	{ LOCATION = G11; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }	# J1 en[1]  -> B
set_pin_assignment	{ HUB_ADDR[2] }	{ LOCATION = G12; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }	# J1 en[2]  -> C
set_pin_assignment	{ HUB_ADDR[3] }	{ LOCATION = H13; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }	# J1 en[4]  -> D
set_pin_assignment	{ HUB_ADDR[4] }	{ LOCATION = H14; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }	# J1 en[5]  -> E
set_pin_assignment	{ HUB_CLK }		{ LOCATION = J14; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }	# J1 en[6]
set_pin_assignment	{ HUB_LAT }		{ LOCATION = K16; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }	# J1 en[8]
set_pin_assignment	{ HUB_OE }		{ LOCATION = M16; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }	# J1 en[9]

# SW1: independent four-grid picker, either stable position change is an event.
set_pin_assignment { sw1_picker } { LOCATION = C8; IOSTANDARD = LVCMOS33; PULLTYPE = NONE; }
